#!/bin/sh
# ==============================================================================
# AQJ OS - Getty TTY1 Service
# ==============================================================================

if command -v agetty >/dev/null 2>&1; then
    exec agetty -8 --noclear tty1 38400 linux
elif command -v getty >/dev/null 2>&1; then
    exec getty 38400 tty1 linux
else
    echo "[!] No getty binary found for tty1"
    sleep 5
fi
